{% extends 'elements/list.html.twig' %}

{% set filters = helloasso_history.filters %}

{% set form = {
    'order': {
        'name': "helloasso_history"
    }
} %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%1$s entry", "%1$s entries", nb)|format(nb),
        'route': {
            'name': 'filter_helloasso_history'
        }
    } %}
    {{ parent() }}
{% endblock %}

{% block header %}
    {% set no_action = true %}
    {% set columns = [
        {
            'label': '#',
            'collapse': true
        },
        {
            'label': _T("Date"),
            'order': constant("GaletteHelloasso\\Filters\\HelloassoHistoryList::ORDERBY_DATE"),
            'collapse': true
        },
        {
            'label': _T("Payment nb.", "helloasso"),
            'order': constant("GaletteHelloasso\\Filters\\HelloassoHistoryList::ORDERBY_PAYMENT"),
            'collapse': true
        },
        {
            'label': _T("Payer name", "helloasso"),
            'order': constant("GaletteHelloasso\\Filters\\HelloassoHistoryList::ORDERBY_PAYER"),
            'collapse': true
        },
        {
            'label': _T("Member"),
            'order': constant("GaletteHelloasso\\Filters\\HelloassoHistoryList::ORDERBY_MEMBER"),
            'collapse': true
        },
        {
            'label': _T("Reason", "helloasso"),
            'order': constant("GaletteHelloasso\\Filters\\HelloassoHistoryList::ORDERBY_REASON"),
            'collapse': true
        },
        {
            'label': _T("Amount"),
            'order': constant("GaletteHelloasso\\Filters\\HelloassoHistoryList::ORDERBY_AMOUNT"),
            'collapse': true
        },
        {
            'label': _T("Method", "helloasso"),
            'order': constant("GaletteHelloasso\\Filters\\HelloassoHistoryList::ORDERBY_METHOD"),
            'collapse': true
        },
        {
            'label': _T("State", "helloasso"),
            'order': constant("GaletteHelloasso\\Filters\\HelloassoHistoryList::ORDERBY_STATE"),
            'collapse': true
        },
        {
            'label': _T("Actions"),
            'collapse': true
        }
    ] %}
    {{ parent() }}
{% endblock %}

{% block search %}
    <form action="{{ url_for('filter_helloasso_history') }}" method="post" class="ui form filters">
        <div class="ui secondary yellow segment">
            <div class="five fields">
                <div class="two fields">
                    <div class="field">
                        <label for="start_date_filter">{{ _T('since') }}</label>
                        <div class="ui calendar" id="payments-rangestart">
                            <div class="ui input left icon">
                                <i class="calendar icon" aria-hidden="true"></i>
                                <input placeholder="{{ _T('yyyy-mm-dd format') }}" type="text" name="start_date_filter" id="start_date_filter" maxlength="10" size="10" value="{{ helloasso_history.filters.start_date_filter }}"/>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <label for="end_date_filter">{{ _T('until') }}</label>
                        <div class="ui calendar" id="payments-rangeend">
                            <div class="ui input left icon">
                                <i class="calendar icon" aria-hidden="true"></i>
                                <input placeholder="{{ _T('yyyy-mm-dd format') }}" type="text" name="end_date_filter" id="end_date_filter" maxlength="10" size="10" value="{{ helloasso_history.filters.end_date_filter }}"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="field">
                    <label for="payment_filter">{{ _T('Payment nb.', 'helloasso') }}</label>
                    <input type="text" name="payment_filter" id="payment_filter" value="{{ helloasso_history.filters.payment_filter }}"/>
                </div>
                <div class="field">
                    <label for="payer_filter">{{ _T('Payer name', 'helloasso') }}</label>
                    <input type="text" name="payer_filter" id="payer_filter" value="{{ helloasso_history.filters.payer_filter }}"/>
                </div>
                <div class="field">
                    {% set reasons = helloasso_history.getPaymentReasonsList() %}
                    {% if reasons|length > 0 %}
                        <label for="reason_filter">{{ _T('Reason', 'helloasso') }}</label>
                        <select name="reason_filter" id="reason_filter" class="ui search dropdown">
                            <option value="0">{{ _T('Select a payment reason', 'helloasso') }}</option>
                            {% for reason in reasons %}
                                <option value="{{ reason }}"{% if helloasso_history.filters.reason_filter == reason %} selected="selected"{% endif %}>{{ reason }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </div>
                <div class="field">
                    {% set methods = helloasso_history.getPaymentMethodsList() %}
                    {% if methods|length > 0 %}
                        <label for="method_filter">{{ _T('Method', 'helloasso') }}</label>
                        <select name="method_filter" id="method_filter" class="ui search dropdown">
                            <option value="0">{{ _T('Select a payment method', 'helloasso') }}</option>
                            {% for method in methods %}
                                <option value="{{ method }}"{% if helloasso_history.filters.method_filter == method %} selected="selected"{% endif %}>{{ method }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </div>
            </div>
            <div class="ui right aligned basic fitted segment field">
                <button type="submit" name="filter" class="tooltip action ui labeled icon primary button" title="{{ _T('Apply filters') }}">
                    <i class="search icon" aria-hidden="true"></i>
                    {{ _T('Filter') }}
                </button>
                <button type="submit" name="clear_filter" class="tooltip ui labeled icon button" title="{{ _T('Reset all filters to defaults') }}">
                    <i class="trash alt red icon" aria-hidden="true"></i>
                    {{ _T('Clear filter') }}
                </button>
            </div>
        </div>
    </form>
{% endblock %}

{% block body %}
    {% for log in logs %}
        <tr>
            <td class="center collapsing" data-scope="row">
                {{ loop.index }}
                <span class="visually-hidden">
                    {{ _T("History entry %id")|replace({'%id': loop.index}) }}
                </span>
            </td>
            <td class="left collapsing" data-col-label="{{ _T("Date") }}">
                {{ log.history_date|date(_T("Y-m-d H:i:s")) }}
            </td>
            <td class="left collapsing" data-col-label="{{ _T("Payment nb.", "helloasso") }}">
                {{ log.checkout_id }}
            </td>
            <td class="left collapsing" data-col-label="{{ _T("Payer name", "helloasso") }}">
                {{ log.payer_name }}
            </td>
            <td class="left collapsing" data-col-label="{{ _T("Member") }}">
                {% if log.member_id != 0 %}
                    <a href="{{ url_for("member", {"id": log.member_id}) }}">
                {% endif %}
                    {{ log.member_fullname }}
                {% if log.member_id != 0 %}
                    </a>
                {% endif %}
            </td>
            <td class="left collapsing" data-col-label="{{ _T("Reason", "helloasso") }}">
                {{ log.comments }}
            </td>
            <td class="right collapsing" data-col-label="{{ _T("Amount") }}">
                {{ log.amount }}
            </td>
            <td class="left collapsing" data-col-label="{{ _T("Method", "helloasso") }}">
                {{ log.method }}
            </td>
            <td class="left collapsing" data-col-label="{{ _T("State", "helloasso") }}">
                {% if log.state == constant('GaletteHelloasso\\HelloassoHistory::STATE_PUBLIC') or log.state == constant('GaletteHelloasso\\HelloassoHistory::STATE_PROCESSED') %}
                    <span class="icon-only">
                        <i class="check green icon" aria-hidden="true"></i>
                        <span class="visually-hidden">
                            {{ _T("Payment properly processed", "helloasso") }}
                        </span>
                    </span>
                {% elseif log.state == constant('GaletteHelloasso\\HelloassoHistory::STATE_ERROR') %}
                    <span class="icon-only">
                        <i class="times red icon" aria-hidden="true"></i>
                        <span class="visually-hidden">
                            {{ _T("An error occurred and the corresponding contribution has not been created", "helloasso") }}
                        </span>
                    </span>
                {% elseif log.state == constant('GaletteHelloasso\\HelloassoHistory::STATE_ALREADYDONE') %}
                    <span class="icon-only">
                        <i class="exclamation triangle orange icon" aria-hidden="true"></i>
                        <span class="visually-hidden">
                            {{ _T("Duplicate", "helloasso") }}
                        </span>
                    </span>
                {% endif %}
            </td>
            <td class="left" data-col-label="{{ _T("Actions") }}">
                <a href="{{ log.receipt_url }}" class="icon-only" target="_blank">
                    <i class="file pdf green icon" aria-hidden="true"></i>
                    <span class="visually-hidden">
                        {{ _T("Download HelloAsso payment confirmation of payment nb. %1$s", "helloasso")|replace({"%1$s": log.checkout_id}) }}
                    </span>
                </a>
                <a href="#" class="icon-only view-request" data-modal="modal-{{ loop.index }}">
                    <i class="info circle blue icon" aria-hidden="true"></i>
                    <span class="visually-hidden">
                        {{ _T("View full request of payment nb. %1$s", "helloasso")|replace({"%1$s": log.checkout_id}) }}
                    </span>
                </a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="10" class="emptylist">{{ _T('No results', 'helloasso') }}</td></tr>
    {% endfor %}
{% endblock %}

{% block content %}
    {{ parent() }}

    {% for log in logs %}
        <div id="modal-{{ loop.index }}" class="ui large modal">
            <div class="header">
                {{ _T('Full request of payment nb. %1$s', 'helloasso')|replace({'%1$s': log.checkout_id}) }}
            </div>
            <div class="scrolling content">
                <pre>{{ log.raw_request }}</pre>
            </div>
            <div class="actions">
                <div class="ui labeled icon deny button">
                    <i class="times icon" aria-hidden="true"></i>
                    {{ _T('Close') }}
                </div>
            </div>
        </div>
    {% endfor %}
{% endblock %}

{% block javascripts %}
        <script type="text/javascript">
            $('#nbshow').change(function() {
                this.form.submit();
            });

            document.addEventListener('click', (e) => {
                const trigger = e.target.closest('.view-request');
                if (!trigger) return;

                e.preventDefault();

                const modalSelector = '#' + trigger.dataset.modal;
                $(modalSelector).modal('show');
            });
        </script>
{% endblock %}
