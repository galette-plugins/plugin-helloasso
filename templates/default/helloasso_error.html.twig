{% extends not login.isLogged() ? "public_page.html.twig" : "page.html.twig" %}

{% block content %}
    <div class="ui negative visible icon message">
        <i class="exclamation circle icon"></i>
        <div class="content">
            {{ _T("Your Helloasso payment has failed for technical reasons.", "helloasso") }}
            {% if error %}
                <ul class="list">
                    <li>{{ _T("Payment nb.", "helloasso") }} : <code>{{ error.checkoutIntentId }}</code></li>
                    {% if error.error is defined %}
                        <li>{{ _T("Error", "helloasso") }} : <code>{{ error.error }}</code></li>
                    {% endif %}
                </ul>
            {% endif %}
        </div>
    </div>
{% endblock %}
