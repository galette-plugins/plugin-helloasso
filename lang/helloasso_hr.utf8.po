#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:582
msgid "HelloAsso payment done"
msgstr "HelloAsso plaćanje je završeno"

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:610
msgid ""
"You are back here after clicking a return link from a HelloAsso page. You "
"can proceed with a new payment if you wish."
msgstr ""
"Vratili ste se ovamo klikom na poveznicu za povratak na stranici HelloAssoa. "
"Ako želite, možete nastaviti s novim plaćanjem."

