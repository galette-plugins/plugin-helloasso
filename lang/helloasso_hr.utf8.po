#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:60
msgid "HelloAsso payment"
msgstr "Plaćanje putem HelloAssoa"

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:69
msgid ""
"<strong>Payment could not work</strong>: An error occurred (that has been "
"logged) while loading Helloasso settings from the database.<br/>Please "
"report the issue to the staff."
msgstr ""
"<strong>Plaćanje možda neće raditi</strong>: došlo je do pogreške "
"(zabilježene u zapisniku) pri učitavanju postavki HelloAssoa iz baze "
"podataka.<br/>Prijavite problem upravi."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:70
msgid "Our apologies for the annoyance."
msgstr "Ispričavamo se zbog poteškoća."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:77
msgid ""
"Helloasso details have not been defined. Please ask an administrator to add "
"them in the plugin's settings."
msgstr ""
"Podaci HelloAssoa nisu postavljeni. Zamolite administratora da ih doda u "
"postavkama dodatka."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:105
#: ../templates/default/helloasso_form.html.twig:96
msgid "You have to select an option."
msgstr "Morate odabrati mogućnost."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:120
#: ../templates/default/helloasso_form.html.twig:102
msgid "Please enter an amount."
msgstr "Unesite iznos."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:132
#: ../templates/default/helloasso_form.html.twig:105
msgid ""
"The amount you've entered is lower than the minimum amount for the selected "
"option. Please choose another option or change the amount."
msgstr ""
"Uneseni iznos manji je od najnižeg iznosa za odabranu mogućnost. Odaberite "
"drugu mogućnost ili promijenite iznos."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:156
msgid "An error occurred redirecting to the checkout form."
msgstr "Došlo je do pogreške pri preusmjeravanju na obrazac za plaćanje."

