msgstr "Votre paiement Helloasso a échoué pour des raisons techniques."

#: ../tempcache/helloasso_error.html.twig:81
msgid "Error"
msgstr "Erreur"

#: ../tempcache/helloasso_preferences.html.twig:73
msgid "Cannot load the settings"
msgstr "Impossible de charger les préférences"

#: ../tempcache/helloasso_preferences.html.twig:79
msgid "An error occured while loading the settings from the database."
msgstr ""
"Une erreur est survenue lors du chargement des préférences depuis la base de "
"données."

#: ../tempcache/helloasso_preferences.html.twig:83
msgid "Please, check if the plugin's database has been properly initialized."
msgstr ""
"Veuillez vérifier que la base de données du plugin a été correctement "
"initialisée."

#: ../tempcache/helloasso_preferences.html.twig:98
msgid "Parameters"
msgstr "Paramètres"

#: ../tempcache/helloasso_preferences.html.twig:106
msgid "Connexion status"
msgstr "État de la connexion"

#: ../tempcache/helloasso_preferences.html.twig:120
