msgid "Helloasso"
msgstr "Helloasso"

#: ../lib/GaletteHelloasso/PluginGaletteHelloasso.php:53
#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:190
msgid "Helloasso History"
msgstr "Historique Helloasso"

#: ../lib/GaletteHelloasso/PluginGaletteHelloasso.php:80
