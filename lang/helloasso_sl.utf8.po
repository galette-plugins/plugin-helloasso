#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:60
msgid "HelloAsso payment"
msgstr "Plačilo HelloAsso"

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:69
msgid ""
"<strong>Payment could not work</strong>: An error occurred (that has been "
"logged) while loading Helloasso settings from the database.<br/>Please "
"report the issue to the staff."
msgstr ""
"<strong>Plačilo ni delovalo</strong>: med nalaganjem nastavitev Helloasso iz "
"zbirke podatkov je prišlo do napake (ki je bila zabeležena).<br/>Prosimo, da "
"težavo prijavite osebju."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:70
msgid "Our apologies for the annoyance."
msgstr "Opravičujemo se za motnjo."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:77
msgid ""
"Helloasso details have not been defined. Please ask an administrator to add "
"them in the plugin's settings."
msgstr ""
"Podrobnosti Helloasso niso bile določene. Prosite skrbnika, da jih doda v "
"nastavitvah vtičnika."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:105
#: ../templates/default/helloasso_form.html.twig:96
msgid "You have to select an option."
msgstr "Izbrati morate možnost."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:120
#: ../templates/default/helloasso_form.html.twig:102
msgid "Please enter an amount."
msgstr "Vnesite znesek."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:132
#: ../templates/default/helloasso_form.html.twig:105
msgid ""
"The amount you've entered is lower than the minimum amount for the selected "
"option. Please choose another option or change the amount."
msgstr ""
"Znesek, ki ste ga vnesli, je nižji od minimalnega zneska za izbrano možnost. "
"Izberite drugo možnost ali spremenite znesek."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:156
msgid "An error occurred redirecting to the checkout form."
msgstr "Pri preusmeritvi na obrazec za odjavo je prišlo do napake."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:231
#: ../lib/GaletteHelloasso/PluginGaletteHelloasso.php:55
msgid "Helloasso History"
msgstr "Zgodovina Helloasso"

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:313
msgid "Helloasso Settings"
msgstr "Nastavitve Helloasso"

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:372
msgid "Helloasso settings have been saved."
msgstr "Nastavitve Helloasso so shranjene."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:378
msgid "An error occurred saving helloasso settings."
msgstr "Pri shranjevanju nastavitev helloasso je prišlo do napake."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:582
msgid "HelloAsso payment done"
msgstr "HelloAsso plačilo opravljeno"

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:610
msgid ""
"You are back here after clicking a return link from a HelloAsso page. You "
"can proceed with a new payment if you wish."
msgstr ""
"Ponovno ste tukaj, ko ste kliknili povratno povezavo s strani HelloAsso. Če "
"želite, lahko nadaljujete z novim plačilom."

#: ../lib/GaletteHelloasso/Controllers/HelloassoController.php:625
msgid "Helloasso payment failure"
msgstr "Napaka pri plačilu Helloasso"

#: ../lib/GaletteHelloasso/HelloassoHistory.php:179
msgid "None"
msgstr "Noben"

#: ../lib/GaletteHelloasso/PluginGaletteHelloasso.php:47
msgid "Helloasso"
msgstr "Hello asso"

